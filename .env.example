# Copy this file to .env before you start the stack.
# Compose reads .env by itself. The app gets every setting from this file.

# Required. Use at least 32 characters. Make one with `make jwt-secret`.
JWT_SECRET=

# The API reaches MySQL over the Compose network.
DATABASE_URL=taskmanagement:taskmanagement@tcp(mysql:3306)/taskmanagement?parseTime=true

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=taskmanagement
MYSQL_USER=taskmanagement
MYSQL_PASSWORD=taskmanagement
API_PORT=44001
MYSQL_PORT=44002
