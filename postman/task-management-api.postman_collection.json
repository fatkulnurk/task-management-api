    {
      "name": "Tasks",
      "item": [
        {
          "name": "POST /tasks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Must be a UUID. A new key makes a new task. Use the same key again to get the first response and no new task."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"team_id\": \"{{team_id}}\",\n  \"title\": \"Demo task\",\n  \"description\": \"Created from Postman\",\n  \"status\": \"todo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/tasks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Create a task. Requires an Idempotency-Key header (a UUID). Status must be todo, in_progress, or done. The new task id is saved to the task_id variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"returns a task id\", function () {",
                  "  pm.expect(body.id).to.be.a(\"string\").and.to.have.length.above(0);",
                  "});",
                  "pm.test(\"returns timestamps\", function () {",
                  "  pm.expect(body.created_at).to.be.a(\"string\").and.to.have.length.above(0);",
                  "  pm.expect(body.updated_at).to.be.a(\"string\").and.to.have.length.above(0);",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"task_id\", body.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "POST /tasks (same key - replay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{replay_idempotency_key}}",
                "description": "A fixed UUID. Running this request again returns the first response and makes no new task."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"team_id\": \"{{team_id}}\",\n  \"title\": \"Demo task\",\n  \"description\": \"Created from Postman\",\n  \"status\": \"todo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/tasks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Create a task with a fixed Idempotency-Key. The first run makes the task. Later runs return the same task and the same body, so no duplicate is made. This request does not change the task_id variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"returns a task id\", function () {",
                  "  pm.expect(body.id).to.be.a(\"string\").and.to.have.length.above(0);",
                  "});",
                  "pm.test(\"returns timestamps\", function () {",
                  "  pm.expect(body.created_at).to.be.a(\"string\").and.to.have.length.above(0);",
                  "  pm.expect(body.updated_at).to.be.a(\"string\").and.to.have.length.above(0);",
                  "});",
                  "",
                  "const previous = pm.collectionVariables.get(\"replay_task_id\");",
                  "if (previous) {",
                  "  pm.test(\"replays the first response\", function () {",
                  "    pm.expect(body.id).to.eql(previous);",
                  "  });",
                  "}",
                  "pm.collectionVariables.set(\"replay_task_id\", body.id);"
                ]
              }
            }
          ],
          "response": []
        },
